  <transform>
    <name>Limpieza con JS (etapa 1)</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>cleaning</jsScript_name>
        <jsScript_script>// Objeto utilitario que encapsula funciones y objetos privadas
var utils = {
    state_mapping: {
        "CDMX": "Ciudad de México",
        "D.F": "Ciudad de México",
        "Ciudad de México": "Ciudad de México",
        "Edo. Méx": "Estado de México",
        "Estado de México": "Estado de México",
        "Veracruz": "Veracruz",
        "Oaxaca": "Oaxaca",
        "Hidalgo": "Hidalgo"
    },
    edad_cleaning: function(){
        var edad_limpia = "";
        if (Edad != null &amp;&amp; Edad != "") {
            edad_limpia = Edad.replace(/[^0-9]/g, "");
            if (edad_limpia !== "") {
                return parseInt(edad_limpia, 10);
            }
        }
        return null;
    },
	extract_and_normalize_state: function(location){
        if (location == null || location === "") {
            return null;
        }

        var loc = location
            .replace("Nací en ", "")
            .replace(", antes D.F", "")
            .replace("México D.F -> ", "")
            .replace(",Veracruz", ", Veracruz");

        var parts = loc.split(",");

        for (var i = 0; i &lt; parts.length; i++) {
            var part = parts[i].trim();

            for (var key in utils.state_mapping) {
                if (part.indexOf(key) !== -1) {
                    return utils.state_mapping[key];
                }
            }
        }

        return null;
    },
	promedio_cleaning: function(promedio_raw){
        if (promedio_raw == null || promedio_raw === "") {
            return null;
        }

        var s = promedio_raw.toString();

        s = s.replace(",", ".");

        var match = s.match(/(\d+\.?\d*)/);

        if (!match)
            return null; // si no encuentra número

        var numero = parseFloat(match[1]);

        if (isNaN(numero))
            return null;

        return numero;
    }
};

var edad_cleaned = utils.edad_cleaning();
var state_cleaned = utils.extract_and_normalize_state(Lugar_de_Nacimiento);
var promedio_cleaned = utils.promedio_cleaning(Promedio);</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>edad_cleaned</name>
        <rename>edad_cleaned</rename>
